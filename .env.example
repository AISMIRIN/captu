# Copy to .env and fill in your values.
# docker compose reads .env automatically.

# Host path to the recordings directory (mounted read-only inside the container).
CAPTU_NAS_HOST=/mnt/your/recordings

# Host user/group that owns the bind-mounted data/ and cache/ dirs.
# Default 1000:1000. Set to `id -u`/`id -g` if your host user differs.
CAPTU_UID=1000
CAPTU_GID=1000

# Host port to publish the web UI on (container always listens on 8000).
CAPTU_PORT=8000

# Image tag to pull from ghcr.io/aismirin/captu.
# Default is `latest`; pin a release for reproducible deploys.
#CAPTU_TAG=0.1.0

# Container timezone (affects ingest cron schedule and log timestamps).
#TZ=Asia/Tokyo

# Log filter (tracing_subscriber EnvFilter syntax).
#RUST_LOG=captu=debug,info
